
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres 
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the 
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL="postgresql://evalu8:evalu8@localhost:5432/evalu8?schema=public"

# Local services (defaults match docker-compose.yml)
REDIS_HOST="localhost"
REDIS_PORT="6379"
CHROMA_HOST="localhost"
CHROMA_PORT="8000"
CHROMA_COLLECTION_NAME="ground_truth"

# AWS S3
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID="your-aws-access-key"
S3_SECRET_ACCESS_KEY="your-aws-secret-key"
S3_BUCKET_NAME="your-bucket-name"
# Optional local S3-compatible endpoint (for MinIO). Leave unset for AWS S3.
# S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE="false"

# Google Gemini
GOOGLE_GEMINI_API_KEY="your-gemini-api-key"

# Application
PORT="3000"
NODE_ENV="development"

# External service circuit breakers
CIRCUIT_BREAKER_ENABLED="true"
CIRCUIT_BREAKER_FAILURE_THRESHOLD="3"
CIRCUIT_BREAKER_RESET_TIMEOUT_MS="30000"
