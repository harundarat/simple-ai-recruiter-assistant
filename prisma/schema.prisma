// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model CV {
  id            Int             @id @default(autoincrement())
  original_name String
  hosted_name   String
  url           String
  ProjectReport ProjectReport[]
  Evaluation    Evaluation[]
}

model ProjectReport {
  id            Int          @id @default(autoincrement())
  cv            CV           @relation(fields: [cv_id], references: [id])
  cv_id         Int
  original_name String
  hosted_name   String
  url           String
  Evaluation    Evaluation[]
}

enum EvaluationStatus {
  queued
  processing
  completed
  failed
}

enum EvaluationErrorCode {
  QUEUE_UNAVAILABLE
  STORAGE_UNAVAILABLE
  STORAGE_OBJECT_NOT_FOUND
  KNOWLEDGE_BASE_UNAVAILABLE
  GROUND_TRUTH_NOT_FOUND
  LLM_UNAVAILABLE
  LLM_INVALID_RESPONSE
  INTERNAL_ERROR
}

enum EvaluationFailedStage {
  ENQUEUE
  LOAD_FILES
  LOAD_GROUND_TRUTH
  CV_EVALUATION
  PROJECT_EVALUATION
  FINAL_SYNTHESIS
  SAVE_CHECKPOINT
}

model Evaluation {
  id                Int              @id @default(autoincrement())
  cv                CV               @relation(fields: [cv_id], references: [id])
  cv_id             Int
  projectReport     ProjectReport    @relation(fields: [project_report_id], references: [id])
  project_report_id Int
  job_title         String
  status            EvaluationStatus @default(queued)

  // Result fields (nullable, populated as their pipeline stages complete)
  cv_match_rate      Float?
  cv_feedback        String? @db.Text
  project_score      Float?
  project_feedback   String? @db.Text
  overall_summary    String? @db.Text
  cv_checkpoint      Json?
  project_checkpoint Json?

  // Error tracking (for failed jobs)
  error_code    EvaluationErrorCode?
  failed_stage  EvaluationFailedStage?
  error_message String?                @db.Text
  retry_count   Int                    @default(0)

  // Timing tracking (for monitoring)
  started_at   DateTime?
  completed_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
